---
// 산 위치 지도 — OpenStreetMap 임베드(키 불필요) + 카카오/구글 지도 링크
const { lat, lng, name } = Astro.props;
if (!lat || !lng) return null;

const d = 0.045; // 표시 범위(약 ±5km)
const bbox = [lng - d, lat - d, lng + d, lat + d].map((n) => n.toFixed(5)).join("%2C");
const src = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat.toFixed(5)}%2C${lng.toFixed(5)}`;

const kakao = `https://map.kakao.com/link/map/${encodeURIComponent(name)},${lat},${lng}`;
const google = `https://www.google.com/maps/search/?api=1&query=${lat}%2C${lng}`;
const osmLarge = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=13/${lat}/${lng}`;
---
<section class="map-sec" aria-label={`${name} 위치 지도`}>
  <h2>{name} 위치</h2>
  <div class="map-wrap">
    <iframe
      title={`${name} 위치 지도`}
      src={src}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </div>
  <p class="map-links">
    좌표 {lat.toFixed(4)}, {lng.toFixed(4)} ·
    <a href={kakao} target="_blank" rel="noopener">카카오맵</a> ·
    <a href={google} target="_blank" rel="noopener">구글 지도</a> ·
    <a href={osmLarge} target="_blank" rel="noopener">큰 지도</a>
  </p>
</section>
