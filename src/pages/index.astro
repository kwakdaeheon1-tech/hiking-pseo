---
import Base from "../layouts/Base.astro";
import AdSlot from "../components/AdSlot.astro";
import mountains from "../data/mountains.json";
import { SITE } from "../consts.mjs";

const byProvince = {};
for (const m of mountains) {
  const p = m.regionShort.split(" ")[0] || "기타";
  (byProvince[p] ??= []).push(m);
}
const provinceOrder = Object.keys(byProvince).sort((a, b) => byProvince[b].length - byProvince[a].length);

const easy = mountains
  .filter((m) => m.feltScore && m.feltScore <= 2 && (m.heightM || 0) < 950)
  .sort((a, b) => (a.heightM || 0) - (b.heightM || 0))
  .slice(0, 8);
const hard = mountains
  .filter((m) => m.feltScore >= 5)
  .sort((a, b) => (b.heightM || 0) - (a.heightM || 0))
  .slice(0, 8);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: "ko",
};
---

<Base path="/" jsonLd={jsonLd}>
  <h1>한국 100대명산 등산코스 가이드</h1>
  <p class="lead">
    산림청이 선정한 100대명산을 산마다 정리했습니다. 대표 등산코스와 구간별 소요시간,
    체감 난이도, 들머리까지 가는 교통·주차, 계절별 추천 시기를 한 페이지에서 확인하세요.
    모든 코스 정보의 출처는 <a href="https://www.data.go.kr/data/15112801/fileData.do" rel="nofollow">산림청 공개 데이터</a>입니다.
  </p>

  <AdSlot place="inarticle" />

  <h2>난이도로 고르기</h2>
  <h3>입문·가벼운 산행 (3시간 안팎)</h3>
  <ul class="mtn-list">
    {easy.map((m) => (
      <li>
        <a href={`/san/${encodeURIComponent(m.slug)}/`}>
          <span>{m.name} 등산코스</span>
          <span class="meta">{m.regionShort} · {m.heightM ?? "?"}m</span>
        </a>
      </li>
    ))}
  </ul>
  <h3>종일 산행·체력 필요 (5시간 이상)</h3>
  <ul class="mtn-list">
    {hard.map((m) => (
      <li>
        <a href={`/san/${encodeURIComponent(m.slug)}/`}>
          <span>{m.name} 등산코스</span>
          <span class="meta">{m.regionShort} · {m.heightM ?? "?"}m</span>
        </a>
      </li>
    ))}
  </ul>

  <h2>지역으로 고르기</h2>
  {provinceOrder.map((p) => (
    <>
      <h3>{p} ({byProvince[p].length})</h3>
      <ul class="mtn-list">
        {byProvince[p]
          .sort((a, b) => a.name.localeCompare(b.name, "ko"))
          .map((m) => (
            <li>
              <a href={`/san/${encodeURIComponent(m.slug)}/`}>
                <span>{m.name} 등산코스</span>
                <span class="meta">{m.regionShort} · {m.heightM ?? "?"}m · {m.feltLevel}</span>
              </a>
            </li>
          ))}
      </ul>
    </>
  ))}

  <AdSlot place="footer" />
</Base>
